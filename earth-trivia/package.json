{
  "name": "geotrivia-earth-explorer",
  "version": "2.0.0",
  "description": "3D Interactive Globe Geography Trivia Game with Direct Country Clicking",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validateData.js",
    "check:clues": "node scripts/checkCluesStep0.js",
    "check:library": "node scripts/checkLibrary.js",
    "check:sources": "node scripts/checkSources.js",
    "check:palette": "node scripts/checkPalette.js",
    "check:contrast": "node scripts/checkContrast.js",
    "bundle:map": "node scripts/bundleMapData.js",
    "build": "esbuild src/main.js --bundle --outfile=dist/bundle.js --format=esm --minify",
    "serve": "node scripts/serve.js",
    "test:random": "node scripts/testRandom.js",
    "test:framing": "node scripts/testMidRangeFraming.js",
    "selfplay": "node scripts/selfplay.js",
    "test": "node scripts/validateData.js && node scripts/testQuestionBag.js && node scripts/testStep1CameraFlight.js && node scripts/testMidRangeFraming.js && node scripts/testStep2CluePoints.js && node scripts/testScoring.js && node scripts/testStep3BugFixes.js && node scripts/testRandom.js && node scripts/testEndlessFinish.js && node scripts/testTiers.js && node scripts/testModals.js"
  },
  "keywords": [
    "geography",
    "trivia",
    "3d",
    "threejs",
    "globe",
    "educational"
  ],
  "author": "vaishnavkk",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "flag-icons": "^7.6.0",
    "three": "^0.182.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "canvas": "^3.2.3",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.19"
  }
}
